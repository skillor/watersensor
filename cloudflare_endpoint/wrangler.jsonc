{
  "name": "watersensor-api",
  "main": "src/worker.js",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-08-08",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "ADMIN_USER": "admin",
    "RATE_LIMIT": "1"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "f4dde238-9f85-4ac4-b981-a25635caece1"
    }
  ]
}